# Optional server-side credentials. Never commit .env or paste keys into the browser.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
BAZAARLINK_API_KEY=
# Set to 0 to reserve Gemini for speech when other text providers are configured.
DECLIC_GEMINI_TEXT_FALLBACK=1
OPENROUTER_MODEL=openrouter/free
DECLIC_DB_PATH=data/declic.sqlite3

# Optional signed-in Ollama Cloud model. No additional key; remote inference requires consent.
DECLIC_OLLAMA_CLOUD_MODEL=
